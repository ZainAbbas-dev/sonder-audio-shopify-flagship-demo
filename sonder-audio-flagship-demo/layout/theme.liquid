<!doctype html>
<html
  {% if request.design_mode %}
    class="shopify-design-mode"
  {% endif %}
  lang="{{ request.locale.iso_code }}"
>
  <head>

  <link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Inter:wght@200;300;400;500;600&display=swap" rel="stylesheet">   

    {%- if settings.favicon != blank -%}
      <link
        rel="icon"
        type="image/png"
        href="{{ settings.favicon | image_url: width: 32, height: 32 }}"
      >
    {%- endif -%}

    {%- render 'view-transition-opt-in' -%}

    {%- render 'meta-tags' -%}
    {%- render 'stylesheets' -%}
    {%- render 'card-hover-effect-styles' -%}
    {%- render 'fonts' -%}
    {%- render 'scripts' -%}
    {%- render 'theme-styles-variables' -%}
    {%- render 'color-palette' -%}

    {% if request.design_mode %}
      {%- render 'theme-editor' -%}
    {% endif %}

    {{ content_for_header }}

    {{ 'sonder-core.css' | asset_url | stylesheet_tag }}

    <!-- ======================================================= -->
    <!-- FIX FOR COLLECTION PAGE: FORCED WHITE BG / BLACK TEXT   -->
    <!-- ======================================================= -->
    {% if template contains 'collection' or template contains 'product' %}
    <style>
      body, html, #MainContent, .section, .gradient, 
      .color-scheme-1, .color-scheme-2, .color-scheme-3, .section-background {
        background-color: #FFFFFF !important;
        background: #FFFFFF !important;
        --color-background: 255, 255, 255 !important;
        --color-foreground: 0, 0, 0 !important;
        --color-base-text: 0, 0, 0 !important;
        --color-base-heading: 0, 0, 0 !important;
      }
      
      .template-collection h1, 
      .template-collection h2, 
      .template-collection h3, 
      .template-collection p, 
      .template-collection span, 
      .template-collection a, 
      .template-product h1, 
      .template-product h2, 
      .template-product h3, 
      .template-product p, 
      .template-product span, 
      .template-product a, 
      .template-product label,
      .card__heading, 
      .card__heading a, 
      .price, 
      .price-item, 
      .facets__heading, 
      .facets__summary, 
      .facets__summary span,
      .select__select, 
      .product-count__text,
      .product__title,
      .product__info-wrapper,
      .quantity__input,
      .icon-caret {
        color: #000000 !important;
      }

      .card, .card__inner, .card__media {
        background: transparent !important;
      }
      
      .select__select, .facets__summary, .quantity {
        border-color: #000000 !important;
      }
    </style>
    {% endif %}
    <!-- ======================================================= -->

    <!-- ======================================================= -->
    <!-- FIX FOR CONTACT PAGE: FORCED WHITE BG / BLACK TEXT (PREMIUM LOOK) -->
    <!-- ======================================================= -->
    {% if template contains 'contact' %}
    <style>
      body, html, #MainContent, .section, .gradient,
      .color-scheme-1, .color-scheme-2, .color-scheme-3, .section-background {
        background-color: #FFFFFF !important;
        background: #FFFFFF !important;
        --color-background: 255, 255, 255 !important;
        --color-foreground: 0, 0, 0 !important;
        --color-base-text: 0, 0, 0 !important;
        --color-base-heading: 0, 0, 0 !important;
      }

      .template-contact h1,
      .template-contact h2,
      .template-contact h3,
      .template-contact p,
      .template-contact span,
      .template-contact a,
      .template-contact label,
      .contact h1,
      .contact h2,
      .contact h3,
      .contact p,
      .contact span,
      .contact a,
      .contact label {
        color: #000000 !important;
      }

      .template-contact .field__input,
      .template-contact input,
      .template-contact textarea,
      .contact .field__input,
      .contact input,
      .contact textarea {
        background-color: #FFFFFF !important;
        color: #000000 !important;
        border: 1px solid #000000 !important;
        border-radius: 2px !important;
      }

      .template-contact .field__label,
      .contact .field__label {
        color: #555555 !important;
      }

      .template-contact .button,
      .contact .button {
        background-color: #000000 !important;
        color: #FFFFFF !important;
        border: 1px solid #000000 !important;
        letter-spacing: 0.05em;
        transition: opacity 0.25s ease;
      }

      .template-contact .button:hover,
      .contact .button:hover {
        opacity: 0.85 !important;
      }
    </style>
    {% endif %}
    <!-- ======================================================= -->

  <!-- GSAP & ScrollTrigger -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/gsap.min.js"></script>
  <script src="https://cdnjs.cloudflare.com/ajax/libs/gsap/3.12.5/ScrollTrigger.min.js"></script>

  </head>

  <body class="page-width-{{ settings.page_width }} card-hover-effect-{{ settings.card_hover_effect }}">
    {% render 'skip-to-content-link', href: '#MainContent', text: 'accessibility.skip_to_text' %}

    {% render 'chat-drawer' %}

    <div class="page-wrapper">
      <div id="header-group">
        {% sections 'header-group' %}
      </div>

      <script>
        /**
         * Sets `--header-height` and `--header-group-height` to measured values before first paint.
         */
        window.measureHeaderHeights = (function () {
          let measured = false;

          return function measureHeaderHeights() {
            if (measured) return;

            const header = document.querySelector('#header-component');
            const headerGroup = document.querySelector('#header-group');

            if (!header || !headerGroup) return;
            measured = true;

            const headerHeight = header.offsetHeight;

            let headerGroupHeight = 0;
            for (const element of headerGroup.children) {
              if (element instanceof HTMLElement) headerGroupHeight += element.offsetHeight;
            }

            if (header.hasAttribute('transparent') && header.parentElement?.nextElementSibling) {
              headerGroupHeight += headerHeight;
            }

            document.body.style.setProperty('--header-height', `${headerHeight}px`);
            document.body.style.setProperty('--header-group-height', `${headerGroupHeight}px`);
          };
        })();

        if (document.querySelector('#header-component')?.hasAttribute('transparent')) {
          measureHeaderHeights();
        }

        (function setTopRowHeight() {
          const header = document.querySelector('#header-component');
          const headerTopRow = header?.querySelector('.header__row--top');
          if (!headerTopRow) return;

          window.requestAnimationFrame(function () {
            header.style.setProperty('--top-row-height', `${headerTopRow.getBoundingClientRect().height}px`);
          });
        })();

        (function updateTransparentHeaderOffset() {
          const header = document.querySelector('#header-component');
          const headerSection = document.querySelector('#header-group .header-section');
          if (!headerSection || !header?.hasAttribute('transparent')) return;

          const hasImmediateSection = headerSection.nextElementSibling?.classList.contains('shopify-section');
          if (!hasImmediateSection) {
            document.body.style.setProperty('--transparent-header-offset-boolean', '1');
          }
        })();

        (function setHeaderMenuStyle() {
          const headerComponent = document.querySelector('#header-component');
          if (headerComponent) {
            const isTouchDevice = 'ontouchstart' in window && navigator.maxTouchPoints > 0;
            const overflowList = headerComponent.querySelector('overflow-list');
            const hasReachedMinimum = overflowList && overflowList.hasAttribute('minimum-reached');
            headerComponent.dataset.menuStyle = isTouchDevice || hasReachedMinimum ? 'drawer' : 'menu';
          }
        })();
      </script>

      <main
        id="MainContent"
        class="content-for-layout"
        role="main"
        data-page-transition-enabled="{{ settings.page_transition_enabled }}"
        data-product-transition="{{ settings.transition_to_main_product }}"
        data-template="{{ template }}"
      >
        {{ content_for_layout }}
      </main>

      <!-- FORCED FOOTER STYLES -->
      <style>
        footer, .footer, #shopify-section-footer, .footer-block__heading {
          --color-foreground: 255, 255, 255 !important;
          --color-base-text: 255, 255, 255 !important;
          color: #FFFFFF !important;
        }
        footer *, .footer * {
          color: #FFFFFF !important;
        }
        footer .rte, footer p, footer a, footer .copyright__content *, .footer__list-item a {
          color: #888888 !important;
        }
        footer a:hover, .footer__list-item a:hover {
          color: #FFFFFF !important;
        }
      </style>

      <footer>
        {% sections 'footer-group' %}
      </footer>
    </div>

    {% render 'cart-drawer', render_wrapper: true %}
    {% render 'theme-drawer' %}

    {% render 'search-modal' %}

    {% if settings.quick_add or settings.mobile_quick_add %}
      {% render 'quick-add-modal' %}
    {% endif %}

    {%- comment -%}
      'sonder-interactions' snippet file is missing from snippets/ folder — this was
      causing the visible error: "Liquid error (layout/theme line 212): Could not
      find asset snippets/sonder-interactions.liquid". Commented out until the file
      is restored/created. See chat notes below.
    {%- endcomment -%}
    {%- comment -%}{% render 'sonder-interactions' %}{% endcomment -%}

  </body>
</html>